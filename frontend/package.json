{
  "name": "zero-climbing-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild src/map.ts --bundle --minify --outfile=../assets/js/map.js",
    "build:css": "tailwindcss -i base.css -o ../assets/css/main.css --minify",
    "watch": "concurrently -n js,css \"npm run watch:js\" \"npm run watch:css\"",
    "watch:js": "esbuild src/map.ts --bundle --watch --outfile=../assets/js/map.js",
    "watch:css": "tailwindcss -i base.css -o ../assets/css/main.css --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.1.0",
    "daisyui": "^4.10.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "ol": "^10.9.0",
    "proj4": "^2.20.9"
  }
}