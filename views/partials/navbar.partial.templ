package partials

templ Navbar(username, email string, fromProtected bool) {
<nav class="navbar bg-white border-b border-slate-200 text-slate-700 fixed top-0 z-10">
		<div class="navbar-start">
			<a hx-swap="transition:true" class="btn btn-ghost text-xl text-slate-900" href="/">
				Zero Climbing
			</a>
		</div>
		<div class="navbar-end">
			if fromProtected {
				<div class="flex flex-col items-end mr-4">
					<span class="font-bold text-slate-700 leading-tight">
						{ username }
					</span>
					if email != "" {
						<span class="text-xs text-slate-400 leading-tight">
							{ email }
						</span>
					}
				</div>
				<button
 					hx-swap="transition:true"
   					hx-post="/logout"
 					hx-confirm="Are you sure you want to log out?"
 					onClick="this.addEventListener('htmx:confirm', (e) => {
 						e.preventDefault()
 						Swal.fire({
 							title: 'Do you want to perform this action?',
 							text: `${e.detail.question}`,
 							icon: 'warning',
 							background: '#ffffff',
 							color: '#1f2937',
 							showCancelButton: true,
 							confirmButtonColor: '#3085d6',
 							cancelButtonColor: '#d33',
 							confirmButtonText: 'Yes'
 						}).then((result) => {
 							if(result.isConfirmed) e.detail.issueRequest(true);
 						})
 					})"
hx-target="body"
 					hx-push-url="true"
 					class="btn btn-ghost text-lg text-slate-700"
 				>
 					Logout
 				</button>
			} else {
				<a hx-swap="transition:true" class="btn btn-ghost text-lg text-slate-700" href="/login">
					Login
				</a>
			}
		</div>
	</nav>
}
