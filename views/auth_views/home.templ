package auth_views

import "github.com/jus4/zero-climbing/views/layout"

templ Home(fromProtected bool) {
	<div id="map" class="w-full h-[100vh]"></div>
}

templ HomeIndex(
	title,
	username,
	email string,
	fromProtected bool,
	isError bool,
	errMsgs, sucMsgs []string,
	cmp templ.Component,
) {
	@layout.Base(title, username, email, fromProtected, isError, errMsgs, sucMsgs) {
		@cmp
	}
}
